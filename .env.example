# =============================================================================
# Ajapopaja Build — local configuration
# =============================================================================
#
# Everything needed to build and run the app locally lives in this one file.
# Copy it to `.env`, edit the values, then run:
#
#   cp .env.example .env
#   # edit .env
#   ./docker-build.sh
#   docker compose up -d
#
# `docker compose` reads `.env` automatically: it drives the `${VAR}`
# interpolation in docker-compose.yml *and* (via the `env_file:` directive)
# becomes the container's runtime environment. `.env` is git-ignored and never
# committed.
#
# NOTE: this file is for LOCAL runs only. The systemd server deployment
# (`deploy-local.sh`) uses its own env file at /etc/ajapopaja-build.env —
# see deploy/prod.env.example.

# -----------------------------------------------------------------------------
# Database and AI services. Inside the container, `host.docker.internal`
# resolves to the host machine, so these reach services running on the host.
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://host.docker.internal:27017/
DATABASE_NAME=ajapopaja_build_prod
OLLAMA_HOST=http://host.docker.internal:11434
# OLLAMA_MODEL=gpt-oss:20b  # optional; defaults based on OLLAMA_API_KEY
# Model used by the CoderBot when spawning `pi` sessions (see
# docker/pi-agent/models.json).
CODERBOT_DEFAULT_MODEL=deepseek-v4.1-flash:cloud

# -----------------------------------------------------------------------------
# WORKSPACES_ROOT — optional; only needed for LOCAL (host-path) pipelines.
#
# The host directory that contains the git repositories Ajapopaja operates on
# directly. If you only use REMOTE pipelines (a repo_uri pointing at a Git
# host), leave this unset — the container falls back to its built-in empty
# /workspaces and remote clones live under REMOTE_WORKSPACES_ROOT.
#
# To expose host repos, uncomment this and set it to your repos root, e.g.:
#   /home/yourname/code
# -----------------------------------------------------------------------------
# WORKSPACES_ROOT=/home/YOUR_USERNAME/path/to/your/repos

# Per-instance writable roots (host path == container path, mounted 1:1).
# These are data directories, not source repos. The defaults are fine for a
# single-instance setup.
PI_SESSIONS_ROOT=/data/ajapopaja/pi_sessions
SANDBOX_ROOT=/data/ajapopaja/sandboxes
REMOTE_WORKSPACES_ROOT=/data/ajapopaja/remote_workspaces

# Ports published to the host (loopback only).
PORT=8081
DEV_SERVER_PORT=1224

# Instance identity.
CONTAINER_NAME=ajapopaja-build

# -----------------------------------------------------------------------------
# Auth (optional for local dev). Without it the app falls back to an insecure
# development secret. Set a distinct value per instance if you expose it:
#   openssl rand -hex 32
# -----------------------------------------------------------------------------
# AUTH_SECRET_KEY=change-me
