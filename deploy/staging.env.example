# Ajapopaja Build - staging environment template.
#
# `deploy-local.sh staging` copies this file to
# /etc/ajapopaja-build-staging.env on first deploy and replaces the
# AUTH_SECRET_KEY placeholder with a freshly generated random secret.
#
# Staging is a second, fully independent instance of the *same* Docker image.
# Every writable external dependency points at its own database / host
# directory so it can never corrupt production state.

# --- Instance identity -------------------------------------------------------
CONTAINER_NAME=ajapopaja-build-staging
AJAPOPAJA_ENV_FILE=/etc/ajapopaja-build-staging.env

# --- Database: a dedicated, clean staging database ---------------------------
MONGODB_URI=mongodb://host.docker.internal:27017/
DATABASE_NAME=ajapopaja_build_staging

# --- Ports (must differ from production) -------------------------------------
PORT=8082
DEV_SERVER_PORT=1225

# --- Writable host directories (mounted 1:1, outside the production roots) ---
WORKSPACES_ROOT=/data/ajapopaja/staging/workspaces
PI_SESSIONS_ROOT=/data/ajapopaja/staging/pi_sessions
SANDBOX_ROOT=/data/ajapopaja/staging/sandboxes
REMOTE_WORKSPACES_ROOT=/data/ajapopaja/staging/remote_workspaces

# --- AI (stateless, shared with production) ----------------------------------
OLLAMA_HOST=http://host.docker.internal:11434
CODERBOT_DEFAULT_MODEL=deepseek-v4.1-flash:cloud

# --- Git hosting: staging repositories only ----------------------------------
# Point every staging pipeline at a staging Gitea repo and use a token scoped
# to that repo. Never reuse the production push token here.
REMOTE_PR_MODE=gitea_pr
GIT_PUSH_USERNAME=CHANGE_ME
GIT_PUSH_TOKEN=CHANGE_ME

# --- Secrets: never share with production ------------------------------------
# Replaced by a random value on the first `deploy-local.sh staging` run.
AUTH_SECRET_KEY=CHANGE_ME
# Cookies are not scoped by port, so production and staging on the same host
# must use different refresh-cookie names.
REFRESH_COOKIE_NAME=refresh_token_staging
# Set to true when the app is served over HTTPS.
AUTH_COOKIE_SECURE=false
# MCP_AUTHENTICATION_ENABLED=false
# MCP_AUTH_TOKEN=
