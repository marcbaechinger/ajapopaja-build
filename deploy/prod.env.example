# Ajapopaja Build - production environment template.
#
# `deploy-local.sh` copies this file to /etc/ajapopaja-build.env on first
# deploy. Edit it to match your host before/after the first run; it is never
# overwritten once it exists.
#
# All variables in this file are forwarded into the container by the
# `env_file` directive in docker-compose.yml and are also used by the systemd
# unit for `${...}` interpolation (ports, volumes, container name).

# --- Instance identity -------------------------------------------------------
CONTAINER_NAME=ajapopaja-build
AJAPOPAJA_ENV_FILE=/etc/ajapopaja-build.env

# --- Database ----------------------------------------------------------------
MONGODB_URI=mongodb://host.docker.internal:27017/
DATABASE_NAME=ajapopaja_build_prod

# --- Ports (must differ from staging) ----------------------------------------
PORT=8081
DEV_SERVER_PORT=1224

# --- Writable host directories (mounted 1:1 into the container) --------------
WORKSPACES_ROOT=/home/marc-baechinger/monolit/code
PI_SESSIONS_ROOT=/data/ajapopaja/pi_sessions
SANDBOX_ROOT=/data/ajapopaja/sandboxes
REMOTE_WORKSPACES_ROOT=/data/ajapopaja/remote_workspaces

# --- AI (stateless, shared with staging) -------------------------------------
OLLAMA_HOST=http://host.docker.internal:11434
CODERBOT_DEFAULT_MODEL=deepseek-v4.1-flash:cloud

# --- Git hosting -------------------------------------------------------------
REMOTE_PR_MODE=gitea_pr
# Per-instance Gitea credentials (leave unset to use each pipeline's repo_token).
# GIT_PUSH_USERNAME=
# GIT_PUSH_TOKEN=

# --- Secrets -----------------------------------------------------------------
# Set an explicit secret so JWTs cannot be replayed across instances.
# AUTH_SECRET_KEY=
